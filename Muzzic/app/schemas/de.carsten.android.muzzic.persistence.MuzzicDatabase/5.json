    "views": [
      {
        "viewName": "songs_enriched",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT s.*,\n        LOWER(REPLACE(REPLACE(s.genre, ' ', ''), '-', '')) AS normalized_genre,\n        CASE WHEN s.artist LIKE 'The %' THEN substr(s.artist, 5) WHEN s.artist LIKE 'An %' THEN substr(s.artist, 4) WHEN s.artist LIKE 'A %' THEN substr(s.artist, 3) ELSE s.artist END AS sort_artist\n    FROM songs s"
      }
    ],
