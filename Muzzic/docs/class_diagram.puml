@startuml
!theme vibrant
skinparam classAttributeIconSize 0

package "Data Layer" {
  package "Entities" {
    class Song {
      +id: String
      +title: String
      +artist: String
      +album: String
      +genre: String
      +duration: Long
      +filePath: String
      +albumArt: String?
      +rating: Int
      +playCount: Int
      +lastPlayed: Long
    }

    class Playlist {
      +id: String
      +name: String
      +isAutoGenerated: Boolean
      +genre: String?
    }

    class PlaylistSong {
      +playlistId: String
      +songId: String
      +position: Int
    }

    class PlayHistory {
      +id: Long
      +songId: String
      +playedAt: Long
    }

    class ArtistAlbum {
        +artist: String
        +album: String
        +albumArt: String?
    }

    class GenrePlayCount {
        +genre: String
        +count: Int
    }

    class MonthlyPlayCount {
        +month: String
        +count: Int
    }

    class SongPlayCount {
        +song: Song
        +totalCount: Int
    }
  }

  package "DAOs" {
    interface SongDao {
      +getAllSongs(): Flow<List<Song>>
      +getTopSongsByGenre(genre: String, limit: Int): List<Song>
      +getAllGenres(): List<String>
      +insertSongs(songs: List<Song>)
      +updateRating(songId: String, rating: Int)
      +incrementPlayCount(songId: String, timestamp: Long)
    }

    interface PlaylistDao {
      +getAllPlaylists(): Flow<List<Playlist>>
      +getSongsInPlaylist(playlistId: String): List<Song>
      +insertPlaylist(playlist: Playlist): Long
      +insertPlaylistSong(playlistSong: PlaylistSong)
    }

    interface PlayHistoryDao {
      +getMonthlyStats(fromTimestamp: Long): List<MonthlyPlayCount>
      +getGenreStats(fromTimestamp: Long): List<GenrePlayCount>
      +getTopSongs(fromTimestamp: Long, limit: Int): List<SongPlayCount>
      +insertPlayHistory(playHistory: PlayHistory)
    }
  }

  package "Repository" {
    class MusicRepository {
      +songDao: SongDao
      +playlistDao: PlaylistDao
      +playHistoryDao: PlayHistoryDao
      +getAllSongs(): Flow<List<Song>>
      +scanMusicLibrary()
      +recordPlay(songId: String)
      +updateSongRating(songId: String, rating: Int)
    }
  }
}

package "UI Layer" {
    package "Composables" {
        class LibraryScreen
        class PlayerScreen
        class PlayingQueueScreen
        class PlaylistsScreen
        class StatisticsScreen
    }


  package "ViewModels" {
    class PlayerViewModel {
      -repository: MusicRepository
      -musicService: StateFlow<MusicPlayerService?>
      +playSong(song: Song)
      +togglePlayPause()
    }

    class PlayingQueueViewModel {
        -repository: PlayingQueueRepository
        +currentPlayingQueue: StateFlow<List<MediaItem>>
        +clear()
    }

    class LibraryViewModel {
        -repository: MusicRepository
        +songs: LiveData<List<Song>>
        +playlists: LiveData<List<Playlist>>
    }

    class StatisticsViewModel {
        -repository: MusicRepository
        +monthlyStats: LiveData<List<MonthlyPlayCount>>
        +genreStats: LiveData<List<GenrePlayCount>>
        +topSongs: LiveData<List<SongPlayCount>>
    }
  }
}

package "Service Layer" {
  class MusicPlayerService {
    -exoPlayer: ExoPlayer
    +isPlayingFlow: StateFlow<Boolean>
    +currentSongFlow: StateFlow<MediaItem?>
    +setPlaylist(newPlaylist: List<MediaItem>, startIndex: Int)
    +play()
    +pause()
    +next()
    +previous()
  }
}

' Relationships
PlayerViewModel --> MusicRepository
PlayerViewModel --> MusicPlayerService
PlayingQueueViewModel --> PlayingQueueRepository
LibraryViewModel --> MusicRepository
StatisticsViewModel --> MusicRepository

LibraryScreen ..> LibraryViewModel
PlayerScreen ..> PlayerViewModel
PlayingQueueScreen ..> PlayingQueueViewModel
PlaylistsScreen ..> LibraryViewModel
StatisticsScreen ..> StatisticsViewModel


MusicRepository *-- SongDao
MusicRepository *-- PlaylistDao
MusicRepository *-- PlayHistoryDao

SongDao ..> Song
PlaylistDao ..> Playlist
PlaylistDao ..> PlaylistSong
PlayHistoryDao ..> PlayHistory
PlayHistoryDao ..> MonthlyPlayCount
PlayHistoryDao ..> GenrePlayCount
PlayHistoryDao ..> SongPlayCount


Playlist "1" *-- "0..*" PlaylistSong
Song "1" *-- "0..*" PlaylistSong
Song "1" *-- "0..*" PlayHistory

@enduml
