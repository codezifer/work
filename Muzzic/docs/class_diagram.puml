@startuml
!theme vibrant
skinparam classAttributeIconSize 0

' --- Layout: geordnete, geradlinige Verbinder ---
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam packageStyle rectangle

package "Data Layer" {
  package "Entities" {
    abstract class AbstractTimestampEntity {
      +createdAt: Instant?
      +updatedAt: Instant?
    }

    abstract class AbstractEntity {
      +id: String
    }

    class Song {
      +title: String
      +trackNumber: Int
      +totalTracks: Int
      +artist: String
      +album: String
      +genre: String
      +duration: Long
      +filePath: String?
      +albumArt: String?
      +albumYear: Int
      +rating: Int
      +playCount: Int
      +lastPlayed: Instant
      +toDto(): SongDto
      +toMediaItem(index: Int?): MediaItem
    }

    class Playlist {
      +name: String
      +isAutoGenerated: Boolean
      +genre: String?
      +toMediaItem(): MediaItem
    }

    class PlaylistSong {
      +playlistId: String
      +songId: String
      +position: Int
    }

    class PlayHistory {
      +songId: String
      +playedAt: Long
    }

    class PlayingQueue {
      +title: String?
      +trackNumber: Int?
      +totalTracks: Int?
      +artist: String?
      +album: String?
      +albumYear: Int?
      +albumArt: String?
      +genre: String?
      +duration: Long?
      +filePath: String?
      +enqueued: Boolean?
      +songId: String?
      +queuePosition: Int
      +toMediaItem(): MediaItem
      +toDto(): PlayingQueueDto
    }

    class PlayerSettings {
      +shuffleEnabled: Boolean
      +repeatMode: Int
    }

    class GenericSetting {
      +settingName: String
      +value: String
      +type: String
    }

    class ArtistAlbum {
      +artist: String
      +album: String
      +albumArt: String?
    }

    class SongsEnriched {
      +song: Song
      +normalizedGenre: String
      +sortArtist: String
    }

    class LibrarySummary {
      +songCount: Int
      +artistCount: Int
      +albumCount: Int
      +genreCount: Int
      +playlistCount: Int
    }

    class PlaylistAggregation {
      +playlistId: String
      +playlistName: String
      +playlistIsAutoGenerated: Boolean
      +playlistGenre: String?
      +artistCount: Int
      +albumCount: Int
      +songCount: Int
      +playlistDuration: Long
    }

    class CanonicalGenreAggregation {
      +normalizedKey: String
      +artistCount: Int
      +albumCount: Int
      +songCount: Int
      +genreDuration: Long
    }

    class GenrePlayCount {
      +genre: String
      +count: Int
    }

    class MonthlyPlayCount {
      +month: String
      +count: Int
    }

    class SongPlayCount {
      +song: Song
      +totalCount: Int
    }
  }

  package "DAOs" {
    interface SongDao {
      +getAllSongs(): Flow<List<Song>>
      +getAllSongsPagingSource(): PagingSource<Int, Song>
      +searchSongs(query: String): List<Song>
      +getSongById(songId: String): Song?
      +getSongsByIds(songId: String): List<Song>
      +getLibrarySummary(): LibrarySummary
      +getMonthlyStats(fromTimestamp: Long, limit: Int): List<MonthlyPlayCount>
      +getGenreStats(fromTimestamp: Long, unknownLabel: String): List<GenrePlayCount>
      +getTopSongs(limit: Int): List<SongPlayCount>
      +insertSong(song: Song)
      +insertSongs(songs: List<Song>)
      +updateRating(songId: String, rating: Int, timestamp: Long)
      +incrementPlayCount(songId: String, timestamp: Long)
      +updatePlayCount(songId: String, playCount: Int, timestamp: Long)
      +deleteSongs(songs: List<Song>)
      +deleteAllSongs()
    }

    interface PlaylistDao {
      +getAllPlaylists(): Flow<List<Playlist>>
      +searchPlaylists(query: String): List<Playlist>
      +getSongsInPlaylist(playlistId: String): List<Song>
      +getSongsByPlaylist(playlistName: String): List<Song>
      +insertPlaylist(playlist: Playlist): Long
      +insertPlaylistSong(playlistSong: PlaylistSong)
      +insertPlaylistSongs(playlistSongs: List<PlaylistSong>)
      +clearPlaylist(playlistId: String)
      +deletePlaylist(playlistId: String)
      +deleteAllPlaylists()
      +getPlaylistAggregation(): Flow<List<PlaylistAggregation>>
    }

    interface PlayHistoryDao {
      +getMonthlyStats(fromTimestamp: Long, limit: Int): List<MonthlyPlayCount>
      +getGenreStats(fromTimestamp: Long): List<GenrePlayCount>
      +getTopSongs(fromTimestamp: Long, limit: Int): List<SongPlayCount>
      +insertPlayHistory(playHistory: PlayHistory)
      +insertPlayHistories(playHistories: List<PlayHistory>)
      +deleteAllPlayHistory()
    }

    interface GenreDao {
      +getSongsByGenres(genres: List<String>): List<Song>
      +getTopSongsByGenre(genre: String, limit: Int): List<Song>
      +getGenreCounts(): List<GenrePlayCount>
      +getGenreAggregations(): Flow<List<GenreAggregation>>
      +getCanonicalGenreAggregations(): Flow<List<CanonicalGenreAggregation>>
    }

    interface ArtistDao {
      +getSongsByArtist(artist: String): List<Song>
      +searchArtists(query: String): List<ArtistAggregation>
      +getArtistAggregations(): Flow<List<ArtistAggregation>>
      +getArtistAggregationsByGenre(genre: String): Flow<List<ArtistAggregation>>
    }

    interface AlbumDao {
      +getAllAlbums(): List<ArtistAlbum>
      +getSongsByAlbum(album: String, artist: String): Flow<List<Song>>
      +searchAlbums(query: String): List<AlbumAggregation>
      +getAlbumAggregation(): Flow<List<AlbumAggregation>>
      +getAlbumsByArtist(artistName: String): Flow<List<AlbumAggregation>>
    }

    interface PlayingQueueDao {
      +findEnqueued(): List<PlayingQueue>
      +observeEnqueued(): Flow<List<PlayingQueue>>
      +findAll(): List<PlayingQueue>
      +observeAll(): Flow<List<PlayingQueue>>
      +clearQueue()
      +addSongs(songs: List<PlayingQueue>)
      +removeSongs(songIds: List<String>)
    }

    interface PlayerSettingsDao {
      +getSettings(): PlayerSettings?
      +observeSettings(): Flow<PlayerSettings?>
      +insertOrUpdate(settings: PlayerSettings)
    }

    interface GenericSettingDao {
      +getSetting(settingName: String): GenericSetting?
      +observeSetting(settingName: String): Flow<GenericSetting?>
      +insertOrUpdate(setting: GenericSetting)
      +deleteSetting(settingName: String)
    }
  }

  package "Repositories" {
    class MusicRepository {
      +getAllSongs(): Flow<List<SongDto>>
      +scanMusicLibrary()
      +importPlaylists()
      +clearLibrary()
      +recordPlay(songId: String)
      +updateSongRating(songId: String, rating: Int)
      +getMonthlyStats(): List<MonthlyPlayCount>
      +getGenreStats(): List<GenrePlayCount>
      +getTopSongs(): List<SongPlayCount>
      +getMonthStats(): List<MonthlyPlayCount>
      +getMonthGenreStats(): List<GenrePlayCount>
      +getTopMonthSongs(): List<SongPlayCount>
      +getLibrarySummary(): LibrarySummary
      +updateAutomaticPlaylists()
    }

    class SongRepository {
      +searchSongs(query: String): List<SongDto>
      +getSongById(songId: String): SongDto?
      +getSongsByIds(songId: String): List<SongDto>
    }

    class PlaylistRepository {
      +getPlaylistInformation(): Flow<List<PlaylistDto>>
      +getSongsInPlaylist(playlistId: String): List<SongDto>
      +getSongsByPlaylist(playlistName: String): List<SongDto>
      +createPlaylistFromSongs(name: String, songs: List<MediaItem>)
      +deletePlaylist(playlistId: String)
    }

    class PlayingQueueRepository {
      +getPlayingQueue(): List<MediaItem>
      +getCompleteQueue(): List<MediaItem>
      +observePlayingQueue(): Flow<List<PlayingQueueDto>>
      +observeEnqueued(): Flow<List<MediaItem>>
      +clear()
      +addSongs(mediaItems: List<MediaItem>, enqueued: Boolean): List<MediaItem>
      +removeSongs(mediaItems: List<MediaItem>)
      +persistQueue(mediaItems: List<MediaItem>)
    }

    class GenreRepository {
      +getSongsByGenre(genre: String): List<SongDto>
      +getGenreVariants(genre: String): List<String>
      +getCanonicalGenreStats(rawStats: List<GenrePlayCount>): List<GenrePlayCount>
      +getGenreInformation(): Flow<List<GenreDto>>
    }

    class ArtistRepository {
      +getArtistInformation(): Flow<List<ArtistDto>>
      +getArtistsByGenre(genreName: String): Flow<List<ArtistDto>>
      +getSongsByArtist(artistName: String): List<SongDto>
      +searchArtists(query: String): List<ArtistDto>
    }

    class AlbumRepository {
      +getAlbumInformation(): Flow<List<AlbumDto>>
      +getAlbumsByArtist(artistName: String): Flow<List<AlbumDto>>
      +getSongsByAlbum(artistName: String, albumName: String): Flow<List<SongDto>>
      +searchAlbums(query: String): List<AlbumDto>
    }

    class SettingsRepository {
      +observeSettings(): Flow<PlayerSettings>
      +getSettings(): PlayerSettings
      +saveShuffleMode(enabled: Boolean)
      +saveRepeatMode(repeatMode: Int)
    }

    class AppSettingsRepository {
      +observeMusicDirectory(): Flow<String?>
      +saveMusicDirectory(path: String)
      +observePlaylistDirectory(): Flow<String?>
      +observeVisualizerEngine(): Flow<VisualizerEngine>
      +saveVisualizerEngine(engine: VisualizerEngine)
    }
  }
}

package "UI Layer" {
  package "Screens" {
    class LibraryScreen
    class PlayerScreen
    class PlayingQueueScreen
    class PlaylistsScreen
    class StatisticsScreen
    class AlbumSongsScreen
    class ArtistAlbumsScreen
    class GenresScreen
    class GenreArtistsScreen
    class SettingsScreen
  }

  package "ViewModels" {
    class PlayerViewModel {
      +browser: StateFlow<MediaBrowser?>
      +uiState: StateFlow<PlayerUiState>
      +songs: StateFlow<List<SongDto>>
      +playSong(songId: String)
      +playArtist(artistName: String)
      +playAlbum(albumTitle: String)
      +togglePlayPause()
      +onNextClicked()
      +onPrevClicked()
      +toggleShuffle()
      +toggleRepeatMode()
      +scanLibrary()
    }

    class PlayingQueueViewModel {
      +uiState: StateFlow<PlayingQueueUiState>
      +playSongAt(index: Int)
      +moveSong(fromIndex: Int, toIndex: Int)
      +shuffleQueue()
      +sortQueueByMetadata()
      +saveAsPlaylist(name: String)
      +clear()
      +togglePlayPause()
    }

    class LibraryViewModel {
      +uiState: StateFlow<LibraryUiState>
      +playSong(song: SongDto)
      +playArtist(artistName: String)
      +playAlbum(artistName: String, albumName: String)
      +playPlaylist(playlistId: String)
      +playGenre(genreName: String)
      +deletePlaylist(playlistId: String)
    }

    class StatisticsViewModel {
      +uiState: StateFlow<StatisticsUiState>
      +loadStats()
    }

    class PlaylistViewModel {
      +persistCurrentQueueAsPlaylist(name: String)
    }

    class AlbumSongsViewModel {
      +uiState: StateFlow<AlbumSongsUiState>
      +playSong(song: SongDto, allSongs: List<SongDto>)
    }

    class ArtistAlbumsViewModel {
      +uiState: StateFlow<ArtistAlbumsUiState>
      +playAlbum(artistName: String, albumName: String)
    }

    class GenresViewModel {
      +uiState: StateFlow<GenresUiState>
      +playArtist(artistName: String)
      +playGenre(genreName: String)
    }

    class SettingsViewModel {
      +uiState: StateFlow<SettingsUiState>
      +updateVisualizerEngine(engine: VisualizerEngine)
      +updateMusicDirectory(path: String)
      +updatePlaylistDirectory(path: String)
      +scanMusicLibrary()
      +importPlaylists()
      +clearLibrary()
    }

    class SelectionViewModel {
      +uiState: StateFlow<SelectionState>
      +toggleArtistSelection(artistName: String)
      +toggleAlbumSelection(artistName: String, albumName: String)
      +toggleSongSelection(songId: String)
      +clearSelection()
    }
  }
}

package "Service Layer" {
  class MusicPlayerService {
    +mediaLibrarySession: MediaLibrarySession
    +onCreate()
    +onGetSession(): MediaLibrarySession?
    +onDestroy()
  }

  class PlaybackManager {
    +exoPlayer: ExoPlayer
    +play()
    +pause()
    +next()
    +previous()
    +seekTo(position: Long)
    +release()
  }

  class QueueManager {
    +loadPersistedQueue(scope: CoroutineScope, player: ExoPlayer)
    +observeQueueChanges(scope: CoroutineScope, player: ExoPlayer)
    +setPlaylist(player: ExoPlayer, newPlaylist: List<MediaItem>, startIndex: Int)
    +playAt(player: ExoPlayer, index: Int)
  }

  class PlaybackStateManager {
    +resolveTransition(player: Player, oldState: Int, newState: Int, isPlaying: Boolean): PlaybackStateTransition
  }

  class PlaybackAnalytics {
    +onNewSong()
    +startMonitoring(scope: CoroutineScope, player: Player)
  }

  class AutomaticPlaylistManager {
    +startMonitoring(scope: CoroutineScope)
    +triggerUpdate()
  }

  class MediaLibraryManager {
    +browser: StateFlow<MediaBrowser?>
    +getChildren(parentId: String): List<MediaItem>
    +playContent(mediaItem: MediaItem)
    +playPlaylist(mediaItems: List<MediaItem>, startIndex: Int)
    +clearPlaylist()
  }

  class MusicPlayerServiceCallback {
    +onGetChildren(parentId: String): List<MediaItem>
    +onSearch(query: String): List<MediaItem>
  }
}

' Inheritance (kurz, vertikal innerhalb Entities)
AbstractTimestampEntity <|-- AbstractEntity
AbstractEntity <|-- Song
AbstractEntity <|-- Playlist
AbstractTimestampEntity <|-- PlaylistSong
AbstractEntity <|-- PlayHistory
AbstractEntity <|-- PlayingQueue
AbstractEntity <|-- PlayerSettings
AbstractEntity <|-- GenericSetting

' ViewModel -> Repository (alle gerade nach oben in den Data Layer)
PlayerViewModel -up-> MusicRepository
PlayerViewModel -up-> AppSettingsRepository
PlayerViewModel -up-> MediaLibraryManager
PlayingQueueViewModel -up-> PlaylistRepository
PlayingQueueViewModel -up-> PlayingQueueRepository
PlayingQueueViewModel -up-> MediaLibraryManager
LibraryViewModel -up-> MusicRepository
LibraryViewModel -up-> PlaylistRepository
LibraryViewModel -up-> PlayingQueueRepository
LibraryViewModel -up-> GenreRepository
LibraryViewModel -up-> ArtistRepository
LibraryViewModel -up-> AlbumRepository
StatisticsViewModel -up-> MusicRepository
StatisticsViewModel -up-> PlaylistRepository
StatisticsViewModel -up-> GenreRepository
PlaylistViewModel -up-> PlaylistRepository
PlaylistViewModel -up-> PlayingQueueRepository
AlbumSongsViewModel -up-> AlbumRepository
ArtistAlbumsViewModel -up-> AlbumRepository
GenresViewModel -up-> GenreRepository
GenresViewModel -up-> ArtistRepository
SettingsViewModel -up-> MusicRepository
SettingsViewModel -up-> AppSettingsRepository
SelectionViewModel -up-> SongRepository
SelectionViewModel -up-> ArtistRepository
SelectionViewModel -up-> AlbumRepository

' Screens -> ViewModels (kurz, vertikal innerhalb UI Layer)
LibraryScreen -down..> LibraryViewModel
PlayerScreen -down..> PlayerViewModel
PlayingQueueScreen -down..> PlayingQueueViewModel
PlaylistsScreen -down..> LibraryViewModel
StatisticsScreen -down..> StatisticsViewModel
AlbumSongsScreen -down..> AlbumSongsViewModel
ArtistAlbumsScreen -down..> ArtistAlbumsViewModel
GenresScreen -down..> GenresViewModel
GenreArtistsScreen -down..> GenresViewModel
SettingsScreen -down..> SettingsViewModel

' Repository -> DAO (gerade nach oben zu den DAOs)
MusicRepository -up-* SongDao
MusicRepository -up-* PlaylistDao
MusicRepository -up-* PlayHistoryDao
MusicRepository -up-* PlayingQueueDao
MusicRepository -up-* GenreRepository
SongRepository -up-* SongDao
PlaylistRepository -up-* PlaylistDao
PlayingQueueRepository -up-* PlayingQueueDao
GenreRepository -up-* GenreDao
ArtistRepository -up-* ArtistDao
AlbumRepository -up-* AlbumDao
SettingsRepository -up-* PlayerSettingsDao
AppSettingsRepository -up-* GenericSettingDao

' DAO -> Entity (gerade nach oben zu den Entities)
SongDao -up..> Song
SongDao -up..> LibrarySummary
SongDao -up..> MonthlyPlayCount
SongDao -up..> GenrePlayCount
SongDao -up..> SongPlayCount
PlaylistDao -up..> Playlist
PlaylistDao -up..> PlaylistSong
PlaylistDao -up..> Song
PlaylistDao -up..> PlaylistAggregation
PlayHistoryDao -up..> PlayHistory
PlayHistoryDao -up..> MonthlyPlayCount
PlayHistoryDao -up..> GenrePlayCount
PlayHistoryDao -up..> SongPlayCount
GenreDao -up..> Song
GenreDao -up..> CanonicalGenreAggregation
ArtistDao -up..> Song
AlbumDao -up..> ArtistAlbum
AlbumDao -up..> Song
PlayingQueueDao -up..> PlayingQueue
PlayerSettingsDao -up..> PlayerSettings
GenericSettingDao -up..> GenericSetting

' Service wiring (kompakt, vertikal innerhalb Service Layer)
MusicPlayerService -down-* PlaybackManager
MusicPlayerService -down-* QueueManager
MusicPlayerService -down-* PlaybackStateManager
MusicPlayerService -down-* PlaybackAnalytics
MusicPlayerService -down-* AutomaticPlaylistManager
MusicPlayerService -down-* MusicPlayerServiceCallback
PlaybackAnalytics -up-> MusicRepository
AutomaticPlaylistManager -up-> MusicRepository
QueueManager -up-> PlayingQueueRepository
PlayerViewModel -right..> MusicPlayerService : via MediaBrowser

' Entity relations (kompakt beieinander)
Playlist "1" -down-* "0..*" PlaylistSong
Song "1" -down-* "0..*" PlaylistSong
Song "1" -down-* "0..*" PlayHistory
Song "1" -down-* "0..*" PlayingQueue
SongsEnriched -right..> Song

@enduml
